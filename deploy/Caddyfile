(app_routes) {
    # Routes API traffic to Django using /api prefix.
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Optional direct access to Django admin and browsable auth pages.
    @django path /admin* /api-auth*
    handle @django {
        reverse_proxy backend:8000
    }

    # Serve Django static files (admin CSS/JS, etc.)
    handle_path /static/* {
        reverse_proxy backend:8000
    }

    # Everything else goes to the React app.
    handle {
        reverse_proxy frontend:80
    }
}

# Port 443
https://{$DOMAIN} {
    encode gzip
    tls /certs/domain.cert.pem /certs/private.key.pem
    import app_routes
}
http://{$DOMAIN} {
    encode gzip
    import app_routes
}

# HTTP ONLY port 80
http://{$PUBLIC_IP} {
    encode gzip
    import app_routes
}

# Accept direct requests by IP or any other host header on port 80.
http://:80 {
    encode gzip
    import app_routes
}
